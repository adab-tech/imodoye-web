# Neon Postgres — pulled automatically via `vercel env pull` once the
# Neon integration is connected to this project (see README)
DATABASE_URL=

# Resend — for application/submission confirmation emails
RESEND_API_KEY=

# Resend inbound — signs the webhook that delivers mail sent to @imodoye.ng
# to app/api/webhooks/resend/route.ts (see Resend dashboard > Webhooks)
RESEND_WEBHOOK_SECRET=
